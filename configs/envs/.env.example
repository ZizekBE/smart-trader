# Public / non-secret defaults — safe to commit as a template.
# Copy to configs/envs/.env and adjust.
#
# Credentials live in configs/secrets/.env (see configs/secrets/.env.example).
# Keys defined in both files: the secrets file wins.

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=trader
DB_NAME=smart_trader

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Trading config ────────────────────────────────────────────
TRADING_MODE=paper
DEFAULT_EXCHANGE=gateio
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAMES=1m,1h,4h,1d,1w

# ── Risk limits ─────────────────────────────────────────────────
MAX_POSITION_SIZE_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10

# ── AI / ML ───────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.65
MODEL_ARTIFACTS_PATH=./models

# ── Observability ─────────────────────────────────────────────
LOG_LEVEL=INFO
PROMETHEUS_PORT=9100
GRAFANA_USER=admin

# ── Rust execution engine ─────────────────────────────────────
RUST_ENGINE_HOST=localhost
RUST_ENGINE_PORT=8080
RUST_LOG=info

# ── pgAdmin (non-secret identity only; password → secrets) ────
PGADMIN_EMAIL=admin@smart-trader.local
